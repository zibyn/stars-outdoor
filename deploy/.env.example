# Copy to deploy/.env on the server. deploy/.env is gitignored: keys never enter the repo.
POSTGRES_PASSWORD=
# Host ports; change if the server already uses them. An existing RustFS works too:
# point S3_ENDPOINT at it and run only `docker compose up -d db`.
DB_PORT=5432
API_PORT=8080
S3_PORT=9000
S3_CONSOLE_PORT=9001
# API: raise MIN_CLIENT_VERSION (an Android versionCode) to make older apps show "update required"
# on online features.
MIN_CLIENT_VERSION=1
# Daily backup (scripts/backup-db.sh): rsync target off this server, e.g. user@nas:/backups/stars
BACKUP_DEST=
# S3: RustFS on the LAN now; later OSS HK (https://oss-cn-hongkong.aliyuncs.com, region oss-cn-hongkong) with a RAM user's AccessKey.
# Use the server's LAN address, not localhost: the API signs offline-package download URLs with this
# host (phones fetch them), and scripts/upload-data.sh may run on another machine.
S3_ENDPOINT=http://192.168.1.10:9000
S3_REGION=us-east-1
# OSS rejects path-style addressing: set false after the move.
S3_PATH_STYLE=true
S3_BUCKET=stars-outdoor
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Third-party keys (#37)
# QWeather authenticates with a JWT signed by an Ed25519 key, not an API key: the account's own
# API host, project ID, credential (key) ID, and the private key file. Keep the .pem in
# deploy/certs/ (gitignored); the path is as seen inside the backend container.
QWEATHER_HOST=
QWEATHER_PROJECT_ID=
QWEATHER_KEY_ID=
QWEATHER_PRIVATE_KEY_PATH=/app/certs/qweather/ed25519-private.pem
# 天地图: a 服务器端 key (the API fetches tiles and 地名搜索 for the app; a 浏览器端 key is refused).
TIANDITU_KEY=
# 搜索: a self-hosted Photon (issue #18); empty = the public photon.komoot.io, fair use only.
PHOTON_URL=
# 登录 (#43, #44): 阿里云号码认证 · 短信认证 (Dypnsapi SendSmsVerifyCode), +86 only. A RAM user with only
# AliyunDypnsFullAccess; sign name and template code come from the console's 赠送签名 / 赠送模板.
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
