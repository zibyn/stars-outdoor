<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- 启动画面 (ux-v3 §8.1): the app icon on the theme's surface, light or dark (values-night). -->
  <color name="splash">#F8F6F0</color>
  <style name="Theme.App.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/splash</item>
    <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
  </style>
</resources>
